<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body>
  <div class="split-page">
    <%- include('partials/marketing') %>
    <div class="auth-page">
      <div class="auth-card">
        <h1><span class="ghost-emoji">👻</span> doneche</h1>
        <p class="tagline">Forgot your password? No worries — we'll email you a reset link.</p>

        <% if (error) { %><p class="error"><%= error %></p><% } %>

        <% if (success) { %>
          <p class="success-msg">✅ If an account exists for that email, a password reset link has been sent. Please check your inbox (and spam folder).</p>
          <p><a href="/login">&larr; Back to Log In</a></p>
        <% } else { %>
          <form method="POST" action="/forgot-password">
            <label>Email</label>
            <input type="email" name="email" required autofocus />
            <button type="submit">Send Reset Link</button>
          </form>
          <p><a href="/login">&larr; Back to Log In</a></p>
        <% } %>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>
</body>
</html>
