<!DOCTYPE html>

<html lang="en">
<head><%- include('partials/head') %></head>
<body>
  <div class="split-page">
    <%- include('partials/marketing') %>
    <div class="auth-page">
      <div class="auth-card">
        <h1><span class="ghost-emoji">👻</span> doneche</h1>

        <p class="tagline">Track applications. Catch ghosting. Follow up in one click.</p>
        <% if (error) { %><p class="error"><%= error %></p><% } %>
        <form method="POST" action="/register">
          <input type="hidden" name="ref" value="<%= typeof ref !== 'undefined' ? ref : '' %>" />
          <% if (typeof ref !== 'undefined' && ref) { %>
            <p class="referral-banner">🎉 You were invited by a friend! Sign up to help them level up.</p>
          <% } %>
          <label>Name</label>
          <input type="text" name="name" required />

          <label>Email</label>
          <input type="email" name="email" required />
          <label>Password</label>
          <div class="password-field">
            <input type="password" name="password" id="registerPassword" required minlength="6" />
            <button type="button" class="password-toggle-btn" aria-label="Show password" onclick="togglePasswordVisibility('registerPassword', this)">👁️</button>
          </div>

          <label class="checkbox-label">
            <input type="checkbox" name="acceptTerms" required />
            I accept the <a href="/terms" target="_blank">Terms and Conditions</a> and <a href="/privacy" target="_blank">Privacy Policy</a>
          </label>

          <button type="submit">Create Free Account</button>
        </form>

        <p>Already have an account? <a href="/login">Log in</a></p>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script>
    function togglePasswordVisibility(inputId, btn) {
      const input = document.getElementById(inputId);
      const showing = input.type === 'text';
      input.type = showing ? 'password' : 'text';
      btn.textContent = showing ? '👁️' : '🙈';
      btn.setAttribute('aria-label', showing ? 'Show password' : 'Hide password');
    }
  </script>
</body>
</html>
